[Unit]
Description=Disko — live filesystem metadata and space index
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/disko watch / --listen 0.0.0.0:7331
Restart=on-failure
RestartSec=5
# A failing daemon (for example a full disk) would otherwise rescan every 5s.
RestartSteps=8
RestartMaxDelaySec=30min
TimeoutStopSec=30
StateDirectory=disko
StateDirectoryMode=0750
Group=@READER_GROUP@
UMask=0027
# A background indexer: yield CPU and disk to every other process.
Nice=19
CPUSchedulingPolicy=idle
CPUWeight=idle
IOSchedulingClass=idle
IOWeight=1
OOMScoreAdjust=1000
MemoryHigh=1G
MemoryMax=2G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/disko /home /mnt -/media /tmp /var/tmp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

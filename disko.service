[Unit]
Description=Disko — live filesystem metadata and space index
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/disko watch / --listen 0.0.0.0:7331
# Also after a clean exit: a stray SIGTERM or SIGINT ends the daemon with
# status 0, which left it down until someone noticed. `systemctl stop` still
# stops it; systemd never restarts a unit it was asked to stop.
Restart=always
RestartSec=5
# A failing daemon (for example a full disk) would otherwise rescan every 5s.
RestartSteps=8
RestartMaxDelaySec=30min
# The daemon forces its own exit 10 s after SIGTERM; this is a safety margin.
TimeoutStopSec=60
StateDirectory=disko
StateDirectoryMode=0750
Group=@READER_GROUP@
UMask=0027
# A background indexer: yield CPU and disk to every other process. The idle
# classes can starve a service indefinitely while anything else uses the disk,
# so use the lowest best-effort priority and a high nice value instead.
Nice=19
CPUSchedulingPolicy=batch
CPUWeight=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
IOWeight=10
OOMScoreAdjust=1000
# Most of what is charged here is not the process (174 MB peak RSS over a
# 12M-entry index) but the kernel's dentry and inode cache from walking every
# folder, which grows to any limit: of a 1.07 GB peak, 644 MB was reclaimable
# slab and 110 MB anonymous memory. MemoryHigh caps that cache so an indexer
# does not crowd out other work, and dropping it is cheap. With no swap the
# kernel drops that cache at the cap instead of swapping out the daemon's
# small working set, which then had to page back in to scan or stop.
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/disko /home /mnt -/media /tmp /var/tmp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
